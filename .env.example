# Valeurs de développement local uniquement. Copier en .env ; ne jamais committer de vraies clés.
# PostgreSQL est installé directement sur la machine (plus de Docker) : créer une base et un
# utilisateur dédiés, puis renseigner DATABASE_URL dans apps/api/.env, apps/worker/.env et
# apps/scheduler/.env. La file de tâches (pg-boss) utilise la même base, schéma « pgboss ».

# Voice generation is opt-in; never commit real keys/tokens.
TTS_PROVIDER=disabled
AUDIO_STORAGE_ROOT=
AUDIO_API_TOKEN=
ELEVENLABS_API_KEY=
