# Prepared only — never deployed by this repo. ${ADMIN_DOMAIN} and ${ACME_EMAIL} come from
# infrastructure/docker/.env; Caddy issues/renews a Let's Encrypt certificate for ADMIN_DOMAIN
# automatically the first time it starts, provided DNS for that domain already points at this VPS and
# ports 80/443 are reachable from the internet. Until a real domain is configured and DNS is live,
# leave the `proxy` service in compose.production.yaml stopped.
{$ADMIN_DOMAIN} {
	# The one public, unauthenticated path in the whole stack (mission 15 section 4) — Meta's Content
	# Publishing fetch cannot present our admin Bearer token, so this single path is carved out to the
	# api container; everything else on this domain goes to the admin BFF. The api container's own
	# port is never otherwise reachable from outside the `application` Docker network.
	handle /public/quiz-video-links/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3100
	}
}
