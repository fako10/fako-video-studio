# Copy to .env in this directory; never commit the real values. Protect with chmod 600.
POSTGRES_USER=fako
POSTGRES_PASSWORD=replace-with-production-password
POSTGRES_DB=fako
# URL-encode the password here. The Docker service hostname is postgres.
DATABASE_URL=postgresql://fako:replace-with-production-password@postgres:5432/fako?schema=public
API_PORT=3000
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000

# Shared admin Bearer token (32+ chars) — every API route except the public Instagram link route
# requires it. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUIZ_VIDEO_API_TOKEN=
QUIZ_VIDEO_ENABLED=false
QUIZ_VIDEO_WORKER_CONCURRENCY=1
QUIZ_VIDEO_RENDER_CONCURRENCY=1

# RijPermis content connector — opt-in, disabled by default.
RIJPERMIS_API_ENABLED=false
RIJPERMIS_API_BASE_URL=
RIJPERMIS_API_KEY=
RIJPERMIS_MOCK_MODE=false

# Social accounts/publishing — opt-in, disabled by default. SOCIAL_TOKEN_ENCRYPTION_KEY is 64 hex
# characters (32 bytes); generate the same way as QUIZ_VIDEO_API_TOKEN above.
SOCIAL_ACCOUNTS_ENABLED=false
SOCIAL_MOCK_MODE=false
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Set only during a key rotation — see infrastructure/docker/README.md "Rotation des clés". Same
# value in the api AND worker services; compose.production.yaml passes this through to both.
SOCIAL_TOKEN_ENCRYPTION_KEY_PREVIOUS=
SOCIAL_PUBLISHING_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_APP_AUDITED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_APP_AUDITED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_APP_AUDITED=false

# Instagram's video_url fetch — the public HTTPS origin Meta must be able to reach (same as
# $ADMIN_DOMAIN below). Leave unset to keep Instagram publishing hard-blocked rather than failing
# silently. See docs/social-publishing.md.
PUBLIC_VIDEO_BASE_URL=
PUBLIC_VIDEO_LINK_TTL_MS=7200000

# Quiz generation scheduler (mission 11) — opt-in, disabled by default.
SCHEDULER_ENABLED=false
SCHEDULER_PROJECT_SLUG=rijpermis
SCHEDULER_SLOTS=09:00,16:00,21:00

# Admin interface (apps/web) — never commit real values.
# Generate the hash locally: npm run hash-password --workspace=@fako/web -- "your passphrase"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# 32 bytes hex — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_KEY=
ADMIN_PROJECT_SLUG=rijpermis
# Must be https://<the same domain as ADMIN_DOMAIN below> — used to build exact OAuth redirect URIs.
ADMIN_PUBLIC_BASE_URL=

# Reverse proxy (Caddy) — only matters once you actually start the `proxy` service (see
# infrastructure/docker/README.md: do not start it before DNS for this domain really points here).
ADMIN_DOMAIN=

# Monitoring and operations (mission 15 section 7) — see infrastructure/docker/README.md.
LOG_LEVEL=info
# Prune old quiz video files via infrastructure/docker/prune-videos.sh (dry-run first!). A file is
# only ever eligible once it's at least this old AND has no active/unresolved social publication.
QUIZ_VIDEO_RETENTION_DAYS=90
# Alert threshold (percent) for infrastructure/docker/monitor.sh's disk usage check.
FAKO_DISK_WARN_PERCENT=80
