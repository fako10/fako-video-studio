[Unit]
Description=Fako Video Studio - PostgreSQL + media backup
# Adjust WorkingDirectory to the actual checkout path on the VPS before installing.
[Service]
Type=oneshot
WorkingDirectory=/opt/fako-video-studio
ExecStart=/opt/fako-video-studio/infrastructure/docker/backup.sh
# Fails loudly (non-zero exit) on an empty/incomplete dump or archive — pair with
# `systemctl --failed` or an alerting OnFailure= unit, do not rely on silently reading logs.
