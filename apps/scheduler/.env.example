DATABASE_URL=postgresql://fako:replace-with-local-password@127.0.0.1:5432/fako?schema=public

# Disabled by default. The scheduler only ever calls the cheap request step (mission 10); it never
# renders anything itself.
SCHEDULER_ENABLED=false
SCHEDULER_PROJECT_SLUG=rijpermis
SCHEDULER_TIMEZONE=Europe/Brussels
# Comma-separated HH:mm local times; each triggers both fr and nl.
SCHEDULER_SLOTS=09:00,16:00,21:00
SCHEDULER_GRACE_MINUTES=120
SCHEDULER_MAX_PENDING_JOBS=10
SCHEDULER_TICK_INTERVAL_MS=60000

# RijPermis content connector (mission 7), shared with the API/worker; same values on all three.
RIJPERMIS_API_ENABLED=false
RIJPERMIS_API_BASE_URL=
RIJPERMIS_API_KEY=
RIJPERMIS_MOCK_MODE=false
RIJPERMIS_MEDIA_ROOT=

# Only used by simulate.ts, to rehearse an arbitrary moment (e.g. a day already in the past).
# SCHEDULER_SIMULATE_NOW=2026-01-15T20:30:00.000Z

# Scheduled publication engine (mission 14) — a distinct scheduler (social-publication-scheduler.ts,
# `npm run dev:social-publications`), opt-in and disabled by default, independent of SCHEDULER_ENABLED above.
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_PUBLISHING_MAX_IN_FLIGHT=20
SOCIAL_PUBLISHING_SCHEDULER_TICK_INTERVAL_MS=30000
