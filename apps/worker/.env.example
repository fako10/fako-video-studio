DATABASE_URL=postgresql://fako:replace-with-local-password@127.0.0.1:5433/fako?schema=public
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2
DISPATCH_INTERVAL_MS=2000
SIMULATION_STEP_MS=300
# Set openai explicitly to enable paid generation after configuring your key.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
# Optional prices, USD per million tokens. No price is assumed.
# OPENAI_PRICE_MODEL=exact-model-id-returned-by-provider
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# OPENAI_CACHED_INPUT_USD_PER_MILLION=

# Voice generation is opt-in; never commit real keys/tokens.
TTS_PROVIDER=disabled
AUDIO_STORAGE_ROOT=
ELEVENLABS_API_KEY=

# RijPermis content connector (mission 7) shared with the API; same values on both sides.
RIJPERMIS_API_ENABLED=false
RIJPERMIS_API_BASE_URL=
RIJPERMIS_API_KEY=
RIJPERMIS_MOCK_MODE=false
RIJPERMIS_MEDIA_ROOT=

# Automated quiz-video pipeline (mission 10), opt-in and disabled by default.
QUIZ_VIDEO_ENABLED=false
# disabled | mock | elevenlabs. "mock" is for local development only and is refused if NODE_ENV=production.
QUIZ_VIDEO_TTS_PROVIDER=disabled
QUIZ_VIDEO_STORAGE_ROOT=
QUIZ_VIDEO_AUDIO_CACHE_ROOT=
QUIZ_VIDEO_PUBLIC_DIR=
QUIZ_VIDEO_WORKER_CONCURRENCY=1

# Scheduled publication engine (mission 14), opt-in and disabled by default. SOCIAL_MOCK_MODE and
# SOCIAL_TOKEN_ENCRYPTION_KEY must match apps/api's own values exactly (same connectors, same
# encrypted tokens to decrypt).
SOCIAL_MOCK_MODE=false
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Set only during a key rotation, same value as apps/api's — see infrastructure/docker/README.md.
SOCIAL_TOKEN_ENCRYPTION_KEY_PREVIOUS=
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_PUBLISHING_WORKER_CONCURRENCY=1
SOCIAL_PUBLISHING_RECONCILE_INTERVAL_MS=60000
SOCIAL_PUBLISHING_RECONCILE_GRACE_MS=900000
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_APP_AUDITED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_APP_AUDITED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_APP_AUDITED=false

# Mission 15 section 4: public HTTPS origin Instagram's video_url fetch must be able to reach — the
# reverse proxy's externally visible origin, never a bind address like 127.0.0.1 or API_PORT. Leave
# unset to keep Instagram publishing hard-blocked (BLOCKED, not a silent failure); TikTok/Facebook are
# unaffected either way (they never use a public URL at all).
PUBLIC_VIDEO_BASE_URL=
# How long a minted link stays valid before Meta's fetch must have happened. 2h default: generous
# against Meta's typical processing time (seconds to minutes), far under the container's 24h expiry.
PUBLIC_VIDEO_LINK_TTL_MS=7200000
