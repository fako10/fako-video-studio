# Required for local development: disables the secure-cookie flag (apps/web/src/config.ts), which
# would otherwise reject the session cookie over plain http://127.0.0.1. Never set this to anything
# other than "production" in production.
NODE_ENV=development

# Admin credentials — never commit real values. Generate the hash locally:
#   npm run hash-password --workspace=@fako/web -- "your passphrase"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_KEY=

# The admin server never talks to PostgreSQL/Redis directly — only to the existing API, over HTTP,
# using the same token the mission 10/11 routes already require.
ADMIN_API_BASE_URL=http://127.0.0.1:3000
QUIZ_VIDEO_API_TOKEN=
ADMIN_PROJECT_SLUG=rijpermis

# This server's own public origin — used only to build the exact OAuth redirect URI registered with
# TikTok/Meta (mission 13 §7: strict redirect URI validation). Not derived from the request's Host
# header, which a client can forge.
ADMIN_PUBLIC_BASE_URL=http://127.0.0.1:3100

PORT=3100
HOST=127.0.0.1
