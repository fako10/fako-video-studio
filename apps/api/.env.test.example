# Isolated test configuration — points at a dedicated test database, never the shared dev one
# (which already carries real seeded data, e.g. the `rijpermis` project). Copy to `.env.test`
# (gitignored) and adjust the password. `test:integration` loads this file, not `.env`.
#
# One-time local setup (PostgreSQL installed locally):
#   psql -U postgres -c "CREATE DATABASE fako_test OWNER fako;"
#   DATABASE_URL="postgresql://fako:<your-local-password>@127.0.0.1:5432/fako_test?schema=public" npx prisma migrate deploy --schema apps/api/prisma/schema.prisma
# The job queue (pg-boss) creates its own `pgboss` schema in the same database on first use.
DATABASE_URL=postgresql://fako:replace-with-local-password@127.0.0.1:5432/fako_test?schema=public
HOST=127.0.0.1
PORT=3000

# Every opt-in feature flag below is left unset/false on purpose: integration tests that need a
# feature enabled pass it explicitly as a buildApp() option, not via this file, so tests like
# "disabled by default: creation is refused without configuration" stay meaningful.
AI_PROVIDER=disabled
TTS_PROVIDER=disabled
AUDIO_STORAGE_ROOT=
AUDIO_API_TOKEN=
RIJPERMIS_API_ENABLED=false
RIJPERMIS_MOCK_MODE=false
RIJPERMIS_MEDIA_ROOT=
QUIZ_VIDEO_ENABLED=false
QUIZ_VIDEO_API_TOKEN=
QUIZ_VIDEO_STORAGE_ROOT=
SOCIAL_ACCOUNTS_ENABLED=false
SOCIAL_MOCK_MODE=false
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
