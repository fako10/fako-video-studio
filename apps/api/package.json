{
  "name": "@fako/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "npm run db:generate && tsc",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env.test --test --test-concurrency=1 test/integration/*.test.ts",
    "db:generate": "cd ../.. && prisma generate --schema apps/api/prisma/schema.prisma",
    "db:validate": "prisma validate",
    "predb:migrate": "tsx --env-file-if-exists=.env prisma/print-db-target.ts",
    "db:migrate": "prisma migrate deploy",
    "predb:seed": "tsx --env-file-if-exists=.env prisma/print-db-target.ts",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "predb:editorial": "tsx --env-file-if-exists=.env prisma/print-db-target.ts",
    "db:editorial": "tsx --env-file-if-exists=.env prisma/editorial.ts",
    "predb:reencrypt-social-tokens": "tsx --env-file-if-exists=.env prisma/print-db-target.ts",
    "db:reencrypt-social-tokens": "tsx --env-file-if-exists=.env prisma/reencrypt-social-tokens.ts",
    "predb:prune-old-quiz-videos": "tsx --env-file-if-exists=.env prisma/print-db-target.ts",
    "db:prune-old-quiz-videos": "tsx --env-file-if-exists=.env prisma/prune-old-quiz-videos.ts",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@fako/ai-providers": "0.1.0",
    "@fako/content-sources": "0.1.0",
    "@fako/media-engine": "0.1.0",
    "@fako/publishing": "0.1.0",
    "@fako/quiz-pipeline": "0.1.0",
    "@fako/social-publishing": "0.1.0",
    "@fako/video-jobs": "0.1.0",
    "@fastify/helmet": "^13.2.0",
    "@prisma/client": "^6.12.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bullmq": "^5.0.0",
    "prisma": "6.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
