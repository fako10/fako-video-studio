# Match the values in the root .env; URL-encode the password if necessary.
# Required for local development: unlocks RIJPERMIS_MOCK_MODE/SOCIAL_MOCK_MODE's http:// redirect
# URIs (apps/api/src/routes/social-accounts.ts requires https:// otherwise) and disables secure
# cookies in apps/web. Never set this to anything other than "production" in production.
NODE_ENV=development
DATABASE_URL=postgresql://fako:replace-with-local-password@127.0.0.1:5433/fako?schema=public
HOST=127.0.0.1
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
# Enables the generation endpoint. The API never needs the OpenAI key.
AI_PROVIDER=disabled

# Voice generation is opt-in; never commit real keys/tokens.
TTS_PROVIDER=disabled
AUDIO_STORAGE_ROOT=
AUDIO_API_TOKEN=

# RijPermis content connector is opt-in and disabled by default; never commit a real key.
# HTTPS is required outside test/development. The API never needs the OpenAI or ElevenLabs keys.
RIJPERMIS_API_ENABLED=false
RIJPERMIS_API_BASE_URL=
RIJPERMIS_API_KEY=
# Local-only fake questions, no network call. Refused automatically when NODE_ENV=production.
RIJPERMIS_MOCK_MODE=false
RIJPERMIS_MEDIA_ROOT=

# Automated quiz-video pipeline (mission 10), opt-in and disabled by default; never commit a real token.
# Also protects the scheduler's production-report route (mission 11): same trust boundary.
QUIZ_VIDEO_ENABLED=false
QUIZ_VIDEO_API_TOKEN=
QUIZ_VIDEO_STORAGE_ROOT=

# Social account connectors (mission 13), opt-in and disabled by default; no real OAuth call or
# publication happens even when enabled unless the platform-specific credentials below are also
# set. Reuses QUIZ_VIDEO_API_TOKEN as the Bearer token (same admin trust boundary as above).
SOCIAL_ACCOUNTS_ENABLED=false
# Local-only fake TikTok/Instagram/Facebook connectors, no network call. Lets a real browser walk
# the full OAuth round trip via apps/web's Paramètres page. Refused automatically when
# NODE_ENV=production, same contract as RIJPERMIS_MOCK_MODE.
SOCIAL_MOCK_MODE=false
# 64 hex characters (32 bytes) used to encrypt stored OAuth tokens (AES-256-GCM). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required only when SOCIAL_ACCOUNTS_ENABLED=true; never commit a real value.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Set only during a key rotation (see infrastructure/docker/README.md "Rotation des clés") — the
# previous key, kept only long enough to decrypt tokens not yet re-encrypted under the new one above.
SOCIAL_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# TikTok for Developers (Login Kit + Content Posting API) — never commit real values.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta for Developers — Instagram API with Instagram Login — never commit real values.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta for Developers — Facebook Login for the RijPermis Page — never commit real values.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Scheduled publication engine (mission 14), opt-in and disabled by default — the server-side
# switch that must stay false until you explicitly decide to send anything real. Gates
# apps/api's /social-publications routes AND apps/worker's/apps/scheduler's publication
# worker/tick; none of them touch a real platform unless this is "true" AND SOCIAL_MOCK_MODE is
# "false" AND the platform's own credentials above are configured. Never settable from a browser.
SOCIAL_PUBLISHING_ENABLED=false
# How many SocialPublication rows may sit in READY/PUBLISHING at once before the scheduler stops
# promoting more SCHEDULED rows — bounds job accumulation during a burst (mission 14 section 6).
SOCIAL_PUBLISHING_MAX_IN_FLIGHT=20
# How often apps/scheduler checks for newly-due publications.
SOCIAL_PUBLISHING_SCHEDULER_TICK_INTERVAL_MS=30000
# How long an in-flight (PUBLISHING) publication may wait for a platform's async confirmation
# before being marked OUTCOME_UNKNOWN instead of kept pending forever.
SOCIAL_PUBLISHING_RECONCILE_GRACE_MS=900000
SOCIAL_PUBLISHING_RECONCILE_INTERVAL_MS=60000
SOCIAL_PUBLISHING_WORKER_CONCURRENCY=1

# Per-platform audit/App Review status — never guessed, never defaulted to true. Leave "false"
# (or unset) until that platform's own review has actually passed; an unaudited TikTok app is
# hard-restricted to private-only posts regardless of this value, and getCapabilities() reflects
# that either way, but Instagram/Facebook's canPublishDirectly also depends on this flag.
TIKTOK_APP_AUDITED=false
INSTAGRAM_APP_AUDITED=false
FACEBOOK_APP_AUDITED=false
